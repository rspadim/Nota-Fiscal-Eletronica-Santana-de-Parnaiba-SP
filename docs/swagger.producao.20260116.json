                "schema": {
                  "$ref": "#/components/schemas/EventoPostResponseErro"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoPostResponseErro"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoPostResponseErro"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EventoPostResponseErro"
                }
              },
              "application/json": {
                "schema": {
