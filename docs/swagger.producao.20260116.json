{
  "openapi": "3.0.1",
  "info": {
    "title": "APIs PARA OS CONTRIBUINTES DO ISSQN NO SISTEMA NACIONAL NFS-e",
    "description": "<div>\r\n                        <p><b>Protocolo de comunicação:</b> TLS 1.0, TLS 1.1 e TLS 1.2 com autenticação mútua</p>\r\n                        <p><b>Formato para troca de mensagens:</b> JSON</p>\r\n                        <p><b>Formato dos documentos da NFS-e:</b> XML 1.0 (<a href='https://www.w3.org/TR/REC-xml' target='_blank'>https://www.w3.org/TR/REC-xml</a>)</p>\r\n                        <p><b>Codificação de caracteres:</b> UTF-8</p>\r\n                        <p><b>Certificado digital:</b> Emitido por Autoridade Certificadora ICP-Brasil, tipo A1 ou A3, CNPJ ou CPF, com &quot;Autenticação do Cliente&quot;</p>\r\n                        <p><b>Padrão de assinatura dos documentos XML:</b> XMLDSIG (<a href='https://www.w3.org/TR/xmldsig-core/' target='_blank'>https://www.w3.org/TR/xmldsig-core/</a>)</p>\r\n                        <p><b>Padrão de compactação dos documentos XML para troca de mensagens:</b> GZip com representação base64binary</p>\r\n                        </div>",
    "version": "v1"
  },
