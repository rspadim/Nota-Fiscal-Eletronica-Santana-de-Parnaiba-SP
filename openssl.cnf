# Configuração OpenSSL com SHA1 habilitado para compatibilidade SEFIN
# Este arquivo habilita algoritmos legados como SHA1

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1

# Configurações adicionais
[default]
